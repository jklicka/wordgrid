{
  "name": "wordgrid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5181 --strictPort",
    "test": "vitest run && tsx tools/validate-levels.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "content:words": "tsx tools/build-wordlist.ts",
    "content:levels": "tsx tools/generate-level.ts",
    "content:validate": "tsx tools/validate-levels.ts",
    "content": "npm run content:words && npm run content:levels && npm run content:validate"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0",
    "wordnet-db": "^3.1.14"
  }
}
